{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "dscexpression",
  "rules": {
    "statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "escapedStringLiteral"
        },
        {
          "type": "SYMBOL",
          "name": "_expressionString"
        },
        {
          "type": "SYMBOL",
          "name": "stringLiteral"
        }
      ]
    },
    "escapedStringLiteral": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "[["
            },
            {
              "type": "PATTERN",
              "value": ".*"
            }
          ]
        }
      }
    },
    "_expressionString": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "["
          },
          {
            "type": "SYMBOL",
            "name": "expression"
          },
          {
            "type": "STRING",
            "value": "]"
          }
        ]
      }
    },
    "expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "function",
          "content": {
            "type": "SYMBOL",
            "name": "function"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "accessor",
              "content": {
                "type": "SYMBOL",
                "name": "accessor"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "stringLiteral": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -11,
        "content": {
          "type": "PATTERN",
          "value": "[^\\[][\\s\\S]*"
        }
      }
    },
    "function": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "name",
            "content": {
              "type": "SYMBOL",
              "name": "functionName"
            }
          },
          {
            "type": "STRING",
            "value": "("
          },
          {
            "type": "FIELD",
            "name": "args",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "arguments"
                },
                {
                  "type": "BLANK"
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": ")"
          }
        ]
      }
    },
    "functionName": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "[_a-zA-Z][_a-zA-Z0-9]*(\\.[a-zA-Z0-9]+)?"
        },
        {
          "type": "SYMBOL",
          "name": "_booleanLiteral"
        }
      ]
    },
    "arguments": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_argument"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": ","
              },
              {
                "type": "SYMBOL",
                "name": "_argument"
              }
            ]
          }
        }
      ]
    },
    "_argument": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "expression"
        },
        {
          "type": "SYMBOL",
          "name": "_quotedString"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "boolean"
        }
      ]
    },
    "_quotedString": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "'"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "STRING",
          "value": "'"
        }
      ]
    },
    "string": {
      "type": "PATTERN",
      "value": "([^']|'')*"
    },
    "number": {
      "type": "PATTERN",
      "value": "-?\\d+"
    },
    "boolean": {
      "type": "PREC",
      "value": 0,
      "content": {
        "type": "SYMBOL",
        "name": "_booleanLiteral"
      }
    },
    "_booleanLiteral": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "true"
        },
        {
          "type": "STRING",
          "value": "false"
        }
      ]
    },
    "accessor": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "memberAccess"
          },
          {
            "type": "SYMBOL",
            "name": "index"
          }
        ]
      }
    },
    "memberAccess": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "."
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "memberName"
          }
        }
      ]
    },
    "memberName": {
      "type": "PATTERN",
      "value": "[a-zA-Z0-9_-]+"
    },
    "propertyName": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "'"
        },
        {
          "type": "FIELD",
          "name": "string",
          "content": {
            "type": "SYMBOL",
            "name": "string"
          }
        },
        {
          "type": "STRING",
          "value": "'"
        }
      ]
    },
    "index": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "FIELD",
          "name": "indexValue",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "expression"
              },
              {
                "type": "SYMBOL",
                "name": "number"
              },
              {
                "type": "SYMBOL",
                "name": "propertyName"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "STRING",
      "value": "\n"
    },
    {
      "type": "STRING",
      "value": " "
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [
    "_booleanLiteral",
    "_argument",
    "_quotedString",
    "_expressionString"
  ],
  "supertypes": [],
  "reserved": {}
}