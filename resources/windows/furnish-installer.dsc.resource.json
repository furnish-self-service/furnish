{
  "$schema": "https://aka.ms/dsc/schemas/v3/bundled/resource/manifest.json",
  "type": "Furnish/Installer",
  "description": "Install an .msi or .exe from the collection or a download with a pinned SHA-256",
  "version": "0.1.0",
  "get": {
    "executable": "powershell.exe",
    "args": [
      "-NoLogo",
      "-NonInteractive",
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "furnish-installer.dsc.resource.ps1",
      "get"
    ],
    "input": "env"
  },
  "test": {
    "executable": "powershell.exe",
    "args": [
      "-NoLogo",
      "-NonInteractive",
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "furnish-installer.dsc.resource.ps1",
      "test"
    ],
    "input": "env",
    "return": "state"
  },
  "set": {
    "executable": "powershell.exe",
    "args": [
      "-NoLogo",
      "-NonInteractive",
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "furnish-installer.dsc.resource.ps1",
      "set",
      {
        "whatIfArg": "what-if"
      }
    ],
    "input": "env",
    "handlesExist": true,
    "implementsPretest": true,
    "return": "state"
  },
  "exitCodes": {
    "0": "Success",
    "10": "Invalid arguments",
    "12": "Cancelled: administrator rights were not granted"
  },
  "schema": {
    "embedded": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Installer",
      "type": "object",
      "oneOf": [
        { "required": ["file"], "properties": { "url": false, "sha256": false } },
        { "required": ["url", "sha256"], "properties": { "file": false } }
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "description": "Installer file, relative to the collection root"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "URL of the vendor installer"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$",
          "description": "Expected SHA-256 of the downloaded installer"
        },
        "productCode": {
          "type": "string",
          "pattern": "^\\{[0-9A-Fa-f-]{36}\\}$",
          "description": ".msi: product code; read from the file if omitted"
        },
        "displayName": {
          "type": "string",
          "description": ".exe: name as registered in Apps & features (wildcards allowed)"
        },
        "installArgs": {
          "type": "string",
          "description": ".exe: silent install switches, e.g. /S"
        },
        "uninstallArgs": {
          "type": "string",
          "description": ".exe: switches added to the registered uninstall command, if it has no quiet variant"
        },
        "version": {
          "type": "string",
          "readOnly": true
        },
        "_exist": {
          "type": "boolean"
        },
        "_metadata": {
          "type": "object",
          "readOnly": true,
          "description": "What-if details: the steps a set would perform",
          "properties": {
            "whatIf": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "reportVersions": {
          "type": "string",
          "writeOnly": true,
          "enum": [
            "latest",
            "all"
          ],
          "description": "Set by furnish for required versions: also report versionScheme, via, latestVersion and, with all, availableVersions"
        },
        "targetVersion": {
          "type": "string",
          "writeOnly": true,
          "pattern": "^[A-Za-z0-9.+~:_^][A-Za-z0-9.+~:_^-]*$",
          "description": "Set by furnish for required versions: install or update to exactly this version"
        },
        "latestVersion": {
          "type": "string",
          "readOnly": true,
          "description": "With reportVersions: the newest version on offer, installed or not (for an installer: the version in the file), if known"
        },
        "availableVersions": {
          "type": "array",
          "readOnly": true,
          "items": {
            "type": "string"
          },
          "description": "With reportVersions all: every version that can be installed"
        },
        "versionScheme": {
          "type": "string",
          "readOnly": true,
          "enum": [
            "pacman",
            "dpkg",
            "rpm",
            "brew",
            "nix",
            "winget",
            "generic"
          ],
          "description": "With reportVersions: how versions compare"
        },
        "via": {
          "type": "string",
          "readOnly": true,
          "description": "With reportVersions: what installs it"
        },
        "_inDesiredState": {
          "type": "boolean",
          "readOnly": true
        },
        "command": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._+][A-Za-z0-9._+-]*$",
          "description": "Program to look for if the installer's own installation is absent. An existing executable counts as installed outside Furnish."
        },
        "managedBy": {
          "type": "string",
          "enum": [
            "other"
          ],
          "readOnly": true,
          "description": "Present for an installation managed outside Furnish"
        },
        "path": {
          "type": "string",
          "readOnly": true,
          "description": "Where the program was found, when the package was installed outside furnish (managedBy: other)"
        }
      }
    }
  }
}
