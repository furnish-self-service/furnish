{
  "$schema": "https://aka.ms/dsc/schemas/v3/bundled/resource/manifest.json",
  "type": "Furnish/Package",
  "description": "Install or remove a package with the system package manager (pacman, apt, dnf, zypper, brew)",
  "version": "0.1.0",
  "get": {
    "executable": "furnish-package.dsc.resource.sh",
    "args": ["get"],
    "input": "env"
  },
  "set": {
    "executable": "furnish-package.dsc.resource.sh",
    "args": ["set"],
    "input": "env",
    "handlesExist": true
  },
  "exitCodes": {
    "0": "Success",
    "1": "Invalid arguments",
    "2": "No supported package manager found"
  },
  "schema": {
    "embedded": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Package",
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "Package name" },
        "version": { "type": "string", "readOnly": true, "description": "Installed version" },
        "_exist": { "type": "boolean", "description": "Whether the package should be installed" }
      }
    }
  }
}
