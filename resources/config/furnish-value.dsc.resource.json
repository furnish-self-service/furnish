{
  "$schema": "https://aka.ms/dsc/schemas/v3/bundled/resource/manifest.json",
  "type": "Furnish/Value",
  "description": "A value in a JSON, JSONC, YAML or TOML file",
  "version": "0.1.0",
  "get": {
    "executable": "furnish",
    "args": [
      "dsc-resource",
      "value",
      "get"
    ],
    "input": "stdin"
  },
  "test": {
    "executable": "furnish",
    "args": [
      "dsc-resource",
      "value",
      "test"
    ],
    "input": "stdin",
    "return": "state"
  },
  "set": {
    "executable": "furnish",
    "args": [
      "dsc-resource",
      "value",
      "set",
      {
        "whatIfArg": "--what-if"
      }
    ],
    "input": "stdin",
    "handlesExist": true,
    "implementsPretest": true,
    "return": "state"
  },
  "schema": {
    "embedded": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Value",
      "type": "object",
      "required": [
        "path",
        "location"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "The file's path: absolute or starting with ~/"
        },
        "format": {
          "type": "string",
          "enum": [
            "json",
            "jsonc",
            "yaml",
            "toml"
          ],
          "description": "The file's format (default: from its extension)"
        },
        "location": {
          "type": "string",
          "description": "A singular JSONPath ($.a['b'], $.list[?@.name=='x']) or a JSON Pointer (/a/b)"
        },
        "value": {
          "description": "The value at the location"
        },
        "merge": {
          "type": "string",
          "enum": [
            "replace",
            "deep",
            "member"
          ],
          "description": "replace (default), deep (set value's keys) or member (value is in the list)"
        },
        "removeIf": {
          "type": "array",
          "minItems": 1,
          "description": "Instead of value: install leaves the value as it is, and uninstall removes it only if it is one of these"
        },
        "mode": {
          "type": "string",
          "pattern": "^[0-7]{3,4}$",
          "description": "Unix mode of the file, e.g. '600' (ignored on Windows); not changed on uninstall"
        },
        "private": {
          "type": "boolean",
          "description": "Only the user may access the file: mode 600 on Unix, an access list on Windows; not changed on uninstall"
        },
        "_exist": {
          "type": "boolean",
          "description": "Whether it should be there"
        },
        "backup": {
          "type": "boolean",
          "description": "Keep a timestamped copy of the file before each change"
        },
        "validate": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "A command run on the new file before it replaces the old one; '%s' stands for its path"
        },
        "_inDesiredState": {
          "type": "boolean",
          "readOnly": true
        },
        "_metadata": {
          "type": "object",
          "readOnly": true,
          "description": "What-if details: the steps a set would perform",
          "properties": {
            "whatIf": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
