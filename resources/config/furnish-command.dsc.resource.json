{
  "$schema": "https://aka.ms/dsc/schemas/v3/bundled/resource/manifest.json",
  "type": "Furnish/Command",
  "description": "A setting a tool applies itself: a test command, and commands that set and remove it",
  "version": "0.1.0",
  "get": {
    "executable": "furnish",
    "args": [
      "dsc-resource",
      "command",
      "get"
    ],
    "input": "stdin"
  },
  "test": {
    "executable": "furnish",
    "args": [
      "dsc-resource",
      "command",
      "test"
    ],
    "input": "stdin",
    "return": "state"
  },
  "set": {
    "executable": "furnish",
    "args": [
      "dsc-resource",
      "command",
      "set",
      {
        "whatIfArg": "--what-if"
      }
    ],
    "input": "stdin",
    "handlesExist": true,
    "implementsPretest": true,
    "return": "state"
  },
  "schema": {
    "embedded": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Command",
      "type": "object",
      "required": [
        "test",
        "set"
      ],
      "additionalProperties": false,
      "properties": {
        "test": {
          "type": "object",
          "required": [
            "command"
          ],
          "additionalProperties": false,
          "description": "How to tell whether the setting is applied",
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "exitCode": {
              "type": "integer",
              "description": "The expected exit code (default 0)"
            },
            "output": {
              "type": "string",
              "description": "The expected output"
            },
            "jsonPath": {
              "type": "string",
              "description": "A place in the command's JSON output that must exist"
            },
            "value": {
              "description": "The value expected at jsonPath"
            }
          }
        },
        "set": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "The command that applies the setting"
        },
        "remove": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "The command that removes the setting"
        },
        "_exist": {
          "type": "boolean",
          "description": "Whether it should be there"
        },
        "_inDesiredState": {
          "type": "boolean",
          "readOnly": true
        },
        "_metadata": {
          "type": "object",
          "readOnly": true,
          "description": "What-if details: the steps a set would perform",
          "properties": {
            "whatIf": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
