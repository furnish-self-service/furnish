{
  "$schema": "https://aka.ms/dsc/schemas/v3/bundled/resource/manifest.json",
  "type": "Furnish/Package",
  "description": "Install or remove a package with the system package manager (pacman, apt, dnf, zypper, brew, nix)",
  "version": "0.1.0",
  "get": {
    "executable": "furnish-package.dsc.resource.sh",
    "args": [
      "get"
    ],
    "input": "env"
  },
  "test": {
    "executable": "furnish-package.dsc.resource.sh",
    "args": [
      "test"
    ],
    "input": "env",
    "return": "state"
  },
  "set": {
    "executable": "furnish-package.dsc.resource.sh",
    "args": [
      "set",
      {
        "whatIfArg": "--what-if"
      }
    ],
    "input": "env",
    "handlesExist": true,
    "implementsPretest": true,
    "return": "state"
  },
  "exitCodes": {
    "0": "Success",
    "10": "Invalid arguments",
    "12": "Cancelled: administrator rights were not granted",
    "13": "Cancelled: stopped by the user"
  },
  "schema": {
    "embedded": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Package",
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Package name",
          "pattern": "^[A-Za-z0-9@._+][A-Za-z0-9@._+-]*$"
        },
        "version": {
          "type": "string",
          "readOnly": true,
          "description": "Installed version"
        },
        "_exist": {
          "type": "boolean",
          "description": "Whether the package should be installed"
        },
        "_metadata": {
          "type": "object",
          "readOnly": true,
          "description": "What-if details: the steps a set would perform",
          "properties": {
            "whatIf": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "packageManager": {
          "type": "string",
          "enum": [
            "pacman",
            "apt",
            "dnf",
            "zypper",
            "brew",
            "nix"
          ],
          "description": "Use this package manager (default: the first one found)"
        },
        "_inDesiredState": {
          "type": "boolean",
          "readOnly": true
        },
        "pacmanName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9@._+][A-Za-z0-9@._+-]*$",
          "description": "Package name when pacman installs it (default: name)"
        },
        "aptName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9@._+][A-Za-z0-9@._+-]*$",
          "description": "Package name when apt installs it (default: name)"
        },
        "dnfName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9@._+][A-Za-z0-9@._+-]*$",
          "description": "Package name when dnf installs it (default: name)"
        },
        "zypperName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9@._+][A-Za-z0-9@._+-]*$",
          "description": "Package name when zypper installs it (default: name)"
        },
        "brewName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9@._+][A-Za-z0-9@._+-]*$",
          "description": "Package name when brew installs it (default: name)"
        },
        "nixName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9@._+][A-Za-z0-9@._+-]*$",
          "description": "Package name when nix installs it (default: name)"
        },
        "nixpkgs": {
          "type": "string",
          "pattern": "^[A-Za-z0-9:/._?=&#+][A-Za-z0-9:/._?=&#+-]*$",
          "description": "Flake reference to install Nix packages from (default: the registry's nixpkgs, which NixOS pins to the system's)"
        }
      }
    }
  }
}
