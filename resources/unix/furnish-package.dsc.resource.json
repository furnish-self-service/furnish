{
  "$schema": "https://aka.ms/dsc/schemas/v3/bundled/resource/manifest.json",
  "type": "Furnish/Package",
  "description": "Install or remove a package with the system package manager (pacman, apt, dnf, zypper, brew)",
  "version": "0.1.0",
  "get": {
    "executable": "furnish-package.dsc.resource.sh",
    "args": [
      "get"
    ],
    "input": "env"
  },
  "set": {
    "executable": "furnish-package.dsc.resource.sh",
    "args": [
      "set",
      {
        "whatIfArg": "--what-if"
      }
    ],
    "input": "env",
    "handlesExist": true,
    "implementsPretest": true,
    "return": "state"
  },
  "exitCodes": {
    "0": "Success",
    "10": "Invalid arguments",
    "11": "No supported package manager found"
  },
  "schema": {
    "embedded": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Package",
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Package name",
          "pattern": "^[A-Za-z0-9@._+-]+$"
        },
        "version": {
          "type": "string",
          "readOnly": true,
          "description": "Installed version"
        },
        "_exist": {
          "type": "boolean",
          "description": "Whether the package should be installed"
        },
        "_metadata": {
          "type": "object",
          "readOnly": true,
          "description": "What-if details: the steps a set would perform",
          "properties": {
            "whatIf": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
