{
  "$schema": "https://aka.ms/dsc/schemas/v3/bundled/resource/manifest.json",
  "type": "Furnish/Installer",
  "description": "Install a collection file or a SHA-256-pinned download (.deb, .rpm, .pkg, .dmg)",
  "version": "0.1.0",
  "get": {
    "executable": "furnish-installer.dsc.resource.sh",
    "args": [
      "get"
    ],
    "input": "env"
  },
  "test": {
    "executable": "furnish-installer.dsc.resource.sh",
    "args": [
      "test"
    ],
    "input": "env",
    "return": "state"
  },
  "set": {
    "executable": "furnish-installer.dsc.resource.sh",
    "args": [
      "set",
      {
        "whatIfArg": "--what-if"
      }
    ],
    "input": "env",
    "handlesExist": true,
    "implementsPretest": true,
    "return": "state"
  },
  "exitCodes": {
    "0": "Success",
    "10": "Invalid arguments",
    "12": "Cancelled: administrator rights were not granted",
    "13": "Cancelled: stopped by the user"
  },
  "schema": {
    "embedded": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Installer",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "description": "Installer file, relative to the collection root"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "Download URL for an installer; requires sha256"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$",
          "description": "SHA-256 digest of the downloaded installer"
        },
        "packageId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "description": ".pkg: the package receipt identifier (pkgutil --pkgs); optional for a download with one component"
        },
        "app": {
          "type": "string",
          "pattern": "^[^/]+\\.app$",
          "description": ".dmg: the app bundle to copy to /Applications"
        },
        "version": {
          "type": "string",
          "readOnly": true,
          "description": "Installed version"
        },
        "_exist": {
          "type": "boolean",
          "description": "Whether it should be installed"
        },
        "_metadata": {
          "type": "object",
          "readOnly": true,
          "description": "What-if details: the steps a set would perform",
          "properties": {
            "whatIf": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "_inDesiredState": {
          "type": "boolean",
          "readOnly": true
        },
        "reportVersions": {
          "type": "string",
          "writeOnly": true,
          "enum": [
            "latest",
            "all"
          ],
          "description": "Set by furnish for required versions: also report versionScheme, via, latestVersion and, with all, availableVersions"
        },
        "targetVersion": {
          "type": "string",
          "writeOnly": true,
          "pattern": "^[A-Za-z0-9.+~:_^][A-Za-z0-9.+~:_^-]*$",
          "description": "Set by furnish for required versions: install or update to exactly this version"
        },
        "latestVersion": {
          "type": "string",
          "readOnly": true,
          "description": "With reportVersions: the newest version on offer, installed or not (for an installer: the version in the file), if known"
        },
        "availableVersions": {
          "type": "array",
          "readOnly": true,
          "items": {
            "type": "string"
          },
          "description": "With reportVersions all: every version that can be installed"
        },
        "versionScheme": {
          "type": "string",
          "readOnly": true,
          "enum": [
            "pacman",
            "dpkg",
            "rpm",
            "brew",
            "nix",
            "winget",
            "generic"
          ],
          "description": "With reportVersions: how versions compare"
        },
        "via": {
          "type": "string",
          "readOnly": true,
          "description": "With reportVersions: what installs it"
        },
        "command": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._+][A-Za-z0-9._+-]*$",
          "description": "Program to look for if the installer's own installation is absent. An existing executable counts as installed outside Furnish."
        },
        "managedBy": {
          "type": "string",
          "enum": [
            "other"
          ],
          "readOnly": true,
          "description": "Present for an installation managed outside Furnish"
        },
        "path": {
          "type": "string",
          "readOnly": true,
          "description": "Where the program was found, when the package was installed outside furnish (managedBy: other)"
        }
      },
      "oneOf": [
        {
          "required": [
            "file"
          ],
          "properties": {
            "url": false,
            "sha256": false
          }
        },
        {
          "required": [
            "url",
            "sha256"
          ],
          "properties": {
            "file": false
          }
        }
      ]
    }
  }
}
