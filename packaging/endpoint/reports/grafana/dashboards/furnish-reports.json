{
  "uid": "furnish-reports",
  "title": "furnish reports",
  "tags": [
    "furnish"
  ],
  "schemaVersion": 39,
  "version": 3,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "stale",
        "label": "No inventory for",
        "query": "1d,3d,7d,14d,30d",
        "current": {
          "text": "7d",
          "value": "7d"
        },
        "options": [
          {
            "text": "1d",
            "value": "1d",
            "selected": false
          },
          {
            "text": "3d",
            "value": "3d",
            "selected": false
          },
          {
            "text": "7d",
            "value": "7d",
            "selected": true
          },
          {
            "text": "14d",
            "value": "14d",
            "selected": false
          },
          {
            "text": "30d",
            "value": "30d",
            "selected": false
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Failed operations by app",
      "description": "Failed installs, updates, uninstalls, reinstalls and fallbacks per app. Each bar counts the failures from its time to the next bar.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 1
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "furnish-loki"
          },
          "expr": "sum by (furnish_app) (count_over_time({service_name=\"furnish\", outcome=\"failed\"} | furnish_app != \"\" [$__auto] offset -$__auto))",
          "queryType": "range",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "{{furnish_app}}"
        }
      ],
      "id": 1,
      "datasource": {
        "type": "loki",
        "uid": "furnish-loki"
      }
    },
    {
      "type": "table",
      "title": "Failure rate per app",
      "description": "Failed operations divided by all finished operations (succeeded or failed) in the time range. Needs reporting: all; with reporting: errors every reported operation is a failure.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Failure rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.05
                    },
                    {
                      "color": "red",
                      "value": 0.2
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Failure rate",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "furnish-loki"
          },
          "expr": "(sum by (furnish_app) (count_over_time({service_name=\"furnish\", event=~\"install|update|uninstall|reinstall\", outcome=\"failed\"} [$__range])) or on (furnish_app) 0 * sum by (furnish_app) (count_over_time({service_name=\"furnish\", event=~\"install|update|uninstall|reinstall\", outcome=\"succeeded\"} [$__range]))) / sum by (furnish_app) (count_over_time({service_name=\"furnish\", event=~\"install|update|uninstall|reinstall\", outcome=~\"succeeded|failed\"} [$__range]))",
          "queryType": "instant",
          "editorMode": "code",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "furnish-loki"
          },
          "expr": "sum by (furnish_app) (count_over_time({service_name=\"furnish\", event=~\"install|update|uninstall|reinstall\", outcome=\"failed\"} [$__range]))",
          "queryType": "instant",
          "editorMode": "code",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "furnish-loki"
          },
          "expr": "sum by (furnish_app) (count_over_time({service_name=\"furnish\", event=~\"install|update|uninstall|reinstall\", outcome=~\"succeeded|failed\"} [$__range]))",
          "queryType": "instant",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "furnish_app": "App",
              "Value #A": "Failure rate",
              "Value #B": "Failed",
              "Value #C": "Operations"
            },
            "indexByName": {
              "furnish_app": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            }
          }
        }
      ],
      "id": 2,
      "datasource": {
        "type": "loki",
        "uid": "furnish-loki"
      }
    },
    {
      "type": "table",
      "title": "Fallbacks: apps installed at an earlier version",
      "description": "Successful fallbacks in the time range: after a failed install or update, furnish installed the app from an earlier commit of its collection. Devices stay at that version until a later update succeeds.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Devices",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "furnish-loki"
          },
          "expr": "count by (furnish_app, furnish_collection_commit) (sum by (furnish_app, furnish_collection_commit, device_id) (count_over_time({service_name=\"furnish\", event=\"fallback\", outcome=\"succeeded\"} [$__range])))",
          "queryType": "instant",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "furnish_app": "App",
              "furnish_collection_commit": "Installed commit",
              "Value": "Devices",
              "Value #A": "Devices"
            },
            "indexByName": {
              "furnish_app": 0,
              "furnish_collection_commit": 1,
              "Value": 2,
              "Value #A": 2
            }
          }
        }
      ],
      "id": 3,
      "datasource": {
        "type": "loki",
        "uid": "furnish-loki"
      }
    },
    {
      "type": "bargauge",
      "title": "furnish versions in use",
      "description": "Devices per furnish version, taken from each device's latest report in the time range.",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 8,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Value/",
          "values": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "furnish-loki"
          },
          "expr": "count by (service_version) (max by (device_id, service_version) (max_over_time({service_name=\"furnish\"} | label_format ts=`{{ __timestamp__ | unixEpoch }}` | unwrap ts [$__range])) == on (device_id) group_left max by (device_id) (max by (device_id, service_version) (max_over_time({service_name=\"furnish\"} | label_format ts=`{{ __timestamp__ | unixEpoch }}` | unwrap ts [$__range]))))",
          "queryType": "instant",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "{{service_version}}"
        }
      ],
      "id": 4,
      "datasource": {
        "type": "loki",
        "uid": "furnish-loki"
      }
    },
    {
      "type": "table",
      "title": "Devices without inventory for $stale",
      "description": "Devices that sent an inventory in the time range but none in the last $stale (change it at the top). furnish sends an inventory once a day with reporting: all.",
      "gridPos": {
        "x": 8,
        "y": 17,
        "w": 16,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last inventory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Last inventory",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "furnish-loki"
          },
          "expr": "1000 * (max by (device_id, user_email, host_name) (max_over_time({service_name=\"furnish\", event=\"inventory\"} | label_format ts=`{{ __timestamp__ | unixEpoch }}` | unwrap ts [$__range])) unless on (device_id) sum by (device_id) (count_over_time({service_name=\"furnish\", event=\"inventory\"} [$stale])))",
          "queryType": "instant",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "device_id": "Device",
              "user_email": "User",
              "host_name": "Host",
              "Value": "Last inventory",
              "Value #A": "Last inventory"
            },
            "indexByName": {
              "device_id": 0,
              "user_email": 1,
              "host_name": 2,
              "Value": 3,
              "Value #A": 3
            }
          }
        }
      ],
      "id": 5,
      "datasource": {
        "type": "loki",
        "uid": "furnish-loki"
      }
    },
    {
      "type": "table",
      "title": "Devices on a version that isn't acceptable",
      "description": "Devices whose installed version of an app isn't one of the versions its collection lists, from each device's latest requirement report per app in the time range. notAcceptable: furnish installs an acceptable version with the next update. noneOffered: the package manager offers no acceptable version. Since: when the device reported it; furnish reports only changes, so widen the time range to see devices that have been on such a version for longer.",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Since"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Problem"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "notAcceptable": {
                        "text": "not acceptable",
                        "color": "orange",
                        "index": 0
                      },
                      "noneOffered": {
                        "text": "none offered",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Since",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "furnish-loki"
          },
          "expr": "max by (device_id, user_email, host_name, furnish_app, outcome, furnish_installed_version, furnish_offered_version) (max_over_time({service_name=\"furnish\", event=\"requirement\", outcome=~\"notAcceptable|noneOffered\"} | label_format ts=`{{ __timestamp__ | unixEpochMillis }}` | unwrap ts [$__range])) == on (device_id, furnish_app) group_left max by (device_id, furnish_app) (max_over_time({service_name=\"furnish\", event=\"requirement\"} | label_format ts=`{{ __timestamp__ | unixEpochMillis }}` | unwrap ts [$__range]))",
          "queryType": "instant",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "device_id": "Device",
              "user_email": "User",
              "host_name": "Host",
              "furnish_app": "App",
              "outcome": "Problem",
              "furnish_installed_version": "Installed",
              "furnish_offered_version": "Offered",
              "Value": "Since",
              "Value #A": "Since"
            },
            "indexByName": {
              "device_id": 0,
              "user_email": 1,
              "host_name": 2,
              "furnish_app": 3,
              "outcome": 4,
              "furnish_installed_version": 5,
              "furnish_offered_version": 6,
              "Value": 7,
              "Value #A": 7
            }
          }
        }
      ],
      "id": 7,
      "datasource": {
        "type": "loki",
        "uid": "furnish-loki"
      }
    },
    {
      "type": "logs",
      "title": "Recent failures",
      "description": "Failed operations and collection updates, newest first.",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 12
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "furnish-loki"
          },
          "expr": "{service_name=\"furnish\", outcome=\"failed\"} | line_format `{{.user_email}} on {{.device_id}}: {{.furnish_event}} {{if .furnish_app}}{{.furnish_app}}{{else}}{{.furnish_collection}}{{end}} failed: {{.error_message}}`",
          "queryType": "range",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "id": 6,
      "datasource": {
        "type": "loki",
        "uid": "furnish-loki"
      }
    }
  ]
}
