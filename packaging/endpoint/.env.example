# Copy to .env and fill in. Keep .env readable by root/admins only: it holds the deploy token.
FURNISH_HOST=furnish.myorg.tld
# The certificate for FURNISH_HOST: tls.crt (with intermediates) and tls.key in this folder.
TLS_DIR=./certs
# Caddy only: an ACME contact e-mail for a Let's Encrypt certificate instead,
# or "/certs/tls.crt /certs/tls.key" to use the files in TLS_DIR.
FURNISH_TLS=admin@myorg.tld
GITLAB_URL=https://gitlab.myorg.internal
# printf '%s' 'gitlab+deploy-token-42:gldt-xxxxxxxxxxxxxxxxxxxx' | base64 -w0
ACME_GITLAB_AUTH=
OIDC_ISSUER_URL=https://login.myorg.tld/realms/myorg
OIDC_CLIENT_ID=furnish
# Who may sign in: users whose ID token e-mail is in these domains (comma separated), or * for
# every user of the IdP. Only safe if the IdP sets "email_verified" (Keycloak does, Entra ID
# doesn't); see the endpoint setup.
ALLOWED_EMAIL_DOMAINS=myorg.tld
# Optional: also require membership in one of these groups (comma separated), from the ID token's
# "groups" claim. With Microsoft Entra ID, use this and ALLOWED_EMAIL_DOMAINS=*.
ALLOWED_GROUPS=
# Secrets are files in this folder, readable by the containers but kept out of their environment:
#   mkdir -m 700 secrets
#   openssl rand -base64 32 | tr -d '\n' | tr -- '+/' '-_' > secrets/oauth2_proxy_cookie_secret
#   openssl rand -base64 24 | tr -d '\n' > secrets/grafana_admin_password   # with reports/compose.yml
#   chmod 644 secrets/*
SECRETS_DIR=./secrets
# Only with reports/compose.yml (Loki and Grafana): how long Loki keeps reports.
REPORTS_RETENTION=90d
