# Installs your organization's apps for users without administrator rights (see README:
# "Users without administrator rights"). `sudo furnish service install` installs this unit
# with the path of that furnish binary.
[Unit]
Description=furnish service: installs apps your organization provides
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/furnish service
Restart=on-failure
UMask=0022

[Install]
WantedBy=multi-user.target
