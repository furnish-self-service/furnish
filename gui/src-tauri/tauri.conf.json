{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "furnish",
  "version": "0.1.0",
  "identifier": "io.github.furnish-self-service.furnish",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "furnish",
        "width": 1120,
        "height": 740,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Install apps your organization provides",
    "linux": {
      "deb": {
        "desktopTemplate": "furnish.desktop",
        "depends": [
          "git",
          "libayatana-appindicator3-1",
          "git-lfs"
        ]
      },
      "rpm": {
        "desktopTemplate": "furnish.desktop",
        "depends": [
          "git",
          "libayatana-appindicator3.so.1()(64bit)",
          "git-lfs"
        ]
      }
    },
    "windows": {
      "wix": {
        "fragmentPaths": [
          "wix/service.wxs"
        ],
        "componentRefs": [
          "FurnishServiceControl"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "furnish"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2REM2RTFCMEJDN0M4M0EKUldRNnlNY0xHMjdjbHV1UGlQUk1rZUFBMHFDY1ZqdG1JSEVaWHhEMU5mbitSZklYTHYzSlhHRkYK",
      "requireSignedVersion": true,
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
