{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "furnish",
  "version": "0.1.0",
  "identifier": "io.github.furnish-self-service.furnish",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "furnish",
        "width": 1120,
        "height": 740,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Install apps your organization provides",
    "linux": {
      "deb": {
        "desktopTemplate": "furnish.desktop"
      },
      "rpm": {
        "desktopTemplate": "furnish.desktop"
      }
    }
  }
}
