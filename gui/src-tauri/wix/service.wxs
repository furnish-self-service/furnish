<?xml version="1.0" encoding="utf-8"?>
<!-- The furnish service (`furnish service install`) runs furnish.exe from the install folder. An
     update replaces that file, so the installer stops the service first (also before an uninstall)
     and starts it again at the end, which does nothing where the service isn't installed. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="FurnishServiceControl" Guid="{CC5EC513-D6B1-442E-8222-AD9045D8E0C1}">
        <RegistryValue Root="HKLM" Key="Software\furnish" Name="ServiceControl" Type="integer" Value="1" KeyPath="yes" />
        <ServiceControl Id="FurnishService" Name="furnish" Stop="both" Wait="yes" />
      </Component>
    </DirectoryRef>
    <CustomAction Id="StartFurnishService" Directory="INSTALLDIR" ExeCommand="&quot;[System64Folder]sc.exe&quot; start furnish" Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="StartFurnishService" Before="InstallFinalize">NOT REMOVE~="ALL"</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
